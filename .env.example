# --- Database -----------------------------------------------------------
# PostgreSQL connection string. The database MUST have the pgvector
# extension available (see README.md "PostgreSQL / pgvector setup").
DATABASE_URL="postgresql://user:password@localhost:5432/rag_chatbot"

# --- Chat / generation provider -------------------------------------------
# "openai" (default) or "groq". Groq's free tier needs no credit card and
# is wire-compatible with OpenAI's API, so switching providers is just
# these two lines — no code changes. Get a key at https://console.groq.com
CHAT_PROVIDER="openai"
# CHAT_PROVIDER="groq"

OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."

# Optional override. Defaults: gpt-4o-mini (openai) / llama-3.3-70b-versatile (groq)
# CHAT_MODEL="gpt-4o-mini"

# --- Embedding provider ----------------------------------------------------
# "openai" (default) or "gemini". Google's Gemini API has a free tier that
# needs no credit card. Get a key at https://aistudio.google.com/apikey
EMBEDDING_PROVIDER="openai"
# EMBEDDING_PROVIDER="gemini"

# GEMINI_API_KEY="AIza..."

# Optional override. Defaults: text-embedding-3-small (openai) / gemini-embedding-001 (gemini)
# EMBEDDING_MODEL="text-embedding-3-small"

# Must match the vector(N) dimension in prisma/schema.prisma. Both default
# models above support 1536, so you normally don't need to change this —
# only touch it (and re-run the migration) if you pick a different model.
EMBEDDING_DIMENSIONS="1536"

# --- RAG tuning -----------------------------------------------------------
# Number of chunks retrieved per question.
RAG_TOP_K="5"

# Target size (characters) and overlap for text chunking.
RAG_CHUNK_SIZE="1000"
RAG_CHUNK_OVERLAP="150"

# --- Uploads ----------------------------------------------------------------
MAX_FILE_SIZE_MB="10"

# --- Rate limiting (simple in-memory limiter, see src/lib/security/rateLimit.ts)
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MS="60000"
